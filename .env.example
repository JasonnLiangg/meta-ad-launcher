# Ad Launcher settings. setup.sh copies this file to .env; fill in .env, never this file.
# Keep .env private: the token can create ads and spend money on your ad account.

# Required. Your system user token (README, "Get your Meta token").
META_ACCESS_TOKEN=PASTE_YOUR_TOKEN_HERE

# Required. Your ad account ID, with or without "act_" (Ads Manager URL: ...?act=1234567890).
META_AD_ACCOUNT_ID=PASTE_YOUR_AD_ACCOUNT_ID

# The Facebook Page ads run from when you don't pick one. Run check_setup.py to list your Pages and their IDs.
META_PAGE_ID=

# Your pixel / dataset ID. Needed whenever the launcher creates an ad set. check_setup.py lists yours.
META_PIXEL_ID=

# Optional: the Instagram account for the default Page above, so ads run under your IG handle.
# Blank = Meta uses the Page's own Instagram setup.
META_INSTAGRAM_USER_ID=

# Optional: only if your Meta app has "Require App Secret" switched on.
META_APP_SECRET=

# Optional: advertiser and payer ID for countries that require it (EU, AU, IN, MY, SG, TH, TW).
# Blank = copied from the newest ad set in your account that has one.
META_ADVERTISER_ID=

# off = ads run exactly as you wrote them (Meta's automatic creative changes are opted out).
# meta_default = let Meta decide.
CREATIVE_ENHANCEMENTS=off
